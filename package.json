{
  "name": "dsh-credential-vault",
  "version": "1.1.1",
  "private": false,
  "type": "module",
  "description": "DeepSeek Harness 侧边栏凭据保险箱：本地保存账号密码、API Key 与恢复码，支持访问密码、密保重置、闲置自动锁定，并提供默认脱敏的 Agent 读取工具。",
  "license": "MIT",
  "keywords": ["dsh-plugin", "credential-vault", "security", "passwords", "api-keys"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mysterycode-liwen/dsh-credential-vault.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-sidebar-right"]
    }
  }
}
