{
  "name": "dsh-credential-vault",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "Sidebar credential vault for DeepSeek Harness with an agent read tool.",
  "license": "MIT",
  "keywords": ["dsh-plugin", "credential-vault", "security", "passwords", "api-keys"],
  "repository": {
    "type": "git",
    "url": "https://github.com/mysterycode-liwen/dsh-credential-vault.git"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}
